# ============================================================================
#  Radar des marches publics - configuration
#  Copiez ce fichier en .env puis renseignez vos valeurs.
# ============================================================================

# --- Base de donnees ---------------------------------------------------------
# Mot de passe Postgres (obligatoire avec docker compose).
POSTGRES_PASSWORD=changez-ce-mot-de-passe
# Laissez vide avec docker compose : docker-compose.yml fournit DATABASE_URL.
# Pour un essai local sans Docker, SQLite suffit :
# DATABASE_URL=sqlite:///./data/radar.db

# --- Source Apify : avis d'appel d'offres ------------------------------------
# Token sur console.apify.com > Settings > API & Integrations.
APIFY_TOKEN=
APIFY_ACTOR=publicmoney~marchespublics-morocco-scraper
# Plafond du nombre d'avis par mot-cle : c'est votre plafond de cout.
APIFY_MAX_ITEMS=500
APIFY_MAX_PAGES=20
APIFY_TIMEOUT_SECS=300
# Second actor, schema plus riche. A activer le jour ou il publiera les attributions.
APIFY_DETAIL_ENABLED=false

# --- Source portail : resultats d'attribution --------------------------------
PORTAL_ENABLED=true
PORTAL_BASE_URL=https://www.marchespublics.gov.ma
PORTAL_TIMEOUT_SECS=60

# --- Documents du DCE : CPS, bordereau des prix, reglement -------------------
# Le portail ne laisse telecharger le DCE qu'aux comptes entreprise, cree depuis
# l'Espace fournisseur de marchespublics.gov.ma. Sans ces identifiants, les
# pieces sont referencees mais marquees « compte requis ».
PORTAL_LOGIN=
PORTAL_PASSWORD=
# Apres avoir renseigne les deux lignes ci-dessus :
#   chmod 600 .env
#   radar portal-login-test     <- verifie que la connexion aboutit
#
# Les champs ci-dessous ne sont que des indications : le code decouvre les vrais
# noms dans le formulaire du portail (PRADO les genere, ex. ctl0$body$...).
# Ne les changez que si portal-login-test vous le demande.
PORTAL_LOGIN_PATH=/index.php?page=entreprise.EntrepriseHome
PORTAL_LOGIN_USER_FIELD=login
PORTAL_LOGIN_PASSWORD_FIELD=password
# Taille maximale d'une piece telechargee, en Mo.
DOCUMENTS_MAX_MB=60

# --- Votre entreprise ----------------------------------------------------------
# Raison sociale telle que le portail l'ecrit dans les attributions (la forme
# juridique, SARL ou SA, est ignoree). Elle definit « Mon profil » et votre
# place dans le classement.
COMPANY_NAME=Arcade Equipement

# --- Planification -----------------------------------------------------------
# Intervalle entre deux collectes d'avis, en minutes.
COLLECT_INTERVAL_MINUTES=30
# Intervalle entre deux collectes d'attributions, en heures.
AWARDS_INTERVAL_HOURS=12

# --- Notifications : email ---------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=radar@votre-domaine.ma
# Plusieurs destinataires separes par des virgules.
EMAIL_TO=

# --- Notifications : WhatsApp ------------------------------------------------
# "twilio", "meta", ou vide pour desactiver.
WHATSAPP_PROVIDER=
# Numeros au format international, separes par des virgules : +2126XXXXXXXX
WHATSAPP_TO=
# -- Option Twilio --
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# -- Option Meta (API Cloud WhatsApp) --
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_API_VERSION=v21.0
# Indispensable pour alerter hors de la fenetre de 24 h : nom d'un modele
# approuve comportant une seule variable de corps.
META_TEMPLATE_NAME=
META_TEMPLATE_LANG=fr

# --- Notifications : webhook (Slack, Teams, n8n, Make, votre API...) ---------
WEBHOOK_URL=

# --- Tableau de bord ---------------------------------------------------------
# URL publique, utilisee dans les liens des alertes.
BASE_URL=http://localhost:8000
# Laissez DASHBOARD_USER vide pour un acces sans mot de passe.
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# --- Divers ------------------------------------------------------------------
TIMEZONE=Africa/Casablanca
LOG_LEVEL=INFO
